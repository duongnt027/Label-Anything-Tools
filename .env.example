POSTGRES_USER=label_anything
POSTGRES_PASSWORD=label_anything_secret
POSTGRES_DB=label_anything
DATABASE_URL=postgresql+psycopg2://label_anything:label_anything_secret@localhost:5433/label_anything
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
# JWT lifetime (minutes). Default in app: 30 days. Renewed while using the web UI via /api/auth/refresh.
# ACCESS_TOKEN_EXPIRE_MINUTES=43200
# After first API start, signing key is persisted under STORAGE_ROOT/.jwt_secret_key (Docker volume)
# so rebuilding the api container does not log everyone out. Do not delete that file casually.
STORAGE_ROOT=/data/storage
# Minutes of idle time inside a job before auto-unlock (leaving always unlocks immediately)
JOB_LOCK_TIMEOUT_MINUTES=30
TZ=Asia/Ho_Chi_Minh
VITE_API_URL=http://localhost:8000

# --- Production (docker-compose.prod.yml + scripts/prod-up.sh) ---
# API_REPLICAS=8
# WEB_CONCURRENCY=4
# GUNICORN_TIMEOUT=120
# DB_USE_PGBOUNCER=true
# PGBOUNCER_MAX_CLIENT_CONN=10000
# PGBOUNCER_DEFAULT_POOL_SIZE=120
# POSTGRES_MAX_CONNECTIONS=300
# POSTGRES_SHARED_BUFFERS=256MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
# CLOUDFLARE_TUNNEL_TOKEN=
